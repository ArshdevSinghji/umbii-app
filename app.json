{
  "expo": {
    "name": "umbii-app",
    "slug": "umbii-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "umbiiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Umbii to turn what you say into a meal log.",
        "NSMicrophoneUsageDescription": "Allow Umbii to use the microphone to log meals by voice."
      }
    },
    "android": {
      "package": "com.umbii",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 150,
          "backgroundColor": "#F4F4F5",
          "dark": {
            "image": "./assets/images/splash-wordmark-dark.png",
            "backgroundColor": "#0C0C0E"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Umbii to use the microphone to log meals by voice.",
          "speechRecognitionPermission": "Allow Umbii to turn what you say into a meal log."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#18181B",
          "defaultChannel": "default"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f715112-c05f-467d-96a2-daba42d12073"
      }
    },
    "owner": "arshdev_singh"
  }
}
